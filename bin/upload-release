#!/usr/bin/env bash
# bin/upload-release — publish every artifact in dist/ to a GitHub release.
#
# Usage: bin/upload-release [OPTIONS] [TAG]
#
#   TAG                 release tag; defaults to v<version of snapcraft.yaml>
#   --repo OWNER/REPO   target repo; defaults to the owner/repo parsed from
#                       the 'origin' git remote
#   --title STR         release title (default: the tag)
#   --notes STR|@FILE   release notes body ('@file' reads the file)
#   --generate-notes    let GitHub generate the notes (used when no notes given)
#   --clobber           if the release already exists, re-upload assets over it
#   --dry-run           print the gh commands instead of running them
#
# Requires the gh CLI, authenticated ('gh auth login'). Assets are every
# regular file in dist/ (mpv binary, ONNX models, the snap).

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DIST="${ROOT}/dist"

die() { echo "upload-release: $*" >&2; exit 1; }

REPO=""
NOTES=""
TITLE=""
TAG=""
DRY_RUN=0
CLOBBER=0
GENERATE_NOTES=0

while [ $# -gt 0 ]; do
    case "$1" in
        --repo) REPO="${2:?--repo requires a value}"; shift 2 ;;
        --title) TITLE="${2:?--title requires a value}"; shift 2 ;;
        --notes) NOTES="${2:?--notes requires a value}"; shift 2 ;;
        --generate-notes) GENERATE_NOTES=1; shift ;;
        --dry-run) DRY_RUN=1; shift ;;
        --clobber) CLOBBER=1; shift ;;
        -h|--help) sed -n '2,20p' "${BASH_SOURCE[0]}"; exit 0 ;;
        -*) die "unknown option: $1" ;;
        *)
            [ -z "$TAG" ] || die "multiple tags given"
            TAG="$1"; shift ;;
    esac
done

if [ -z "$TAG" ]; then
    version="$(awk '$1 == "version:" { print $2; exit }' "${ROOT}/snapcraft.yaml" | tr -d '"')"
    version="${version//\"/}"
    [ -n "$version" ] || die "no tag given and no version: line in snapcraft.yaml"
    TAG="v${version}"
fi

shopt -s nullglob
ASSETS=()
for entry in "${DIST}"/*; do
    [ -f "$entry" ] && ASSETS+=("$entry")
done
[ ${#ASSETS[@]} -gt 0 ] || die "no files in ${DIST}"

if [ -z "$REPO" ]; then
    url="$(git remote get-url origin 2>/dev/null || true)"
    if [ -z "$url" ]; then
        url="$(git -C "$ROOT" remote get-url origin 2>/dev/null || true)"
    fi
    case "$url" in
        git@github.com:*) REPO="${url#git@github.com:}"; REPO="${REPO%.git}" ;;
        *github.com/*) REPO="${url#*github.com/}"; REPO="${REPO%.git}" ;;
    esac
fi
[ -n "$REPO" ] || die "cannot determine repo: pass --repo OWNER/REPO or add an 'origin' remote"

if [ "${NOTES#@}" != "$NOTES" ]; then
    notes_file="${NOTES#@}"
    [ -e "$notes_file" ] || die "notes file not found: $notes_file"
    NOTES="$(cat "$notes_file")"
fi

CREATE_ARGS=()
if [ -n "$TITLE" ]; then CREATE_ARGS+=(--title "$TITLE"); fi
if [ -n "$NOTES" ]; then CREATE_ARGS+=(--notes "$NOTES"); fi
if [ "$GENERATE_NOTES" -eq 1 ] && [ -z "$NOTES" ]; then CREATE_ARGS+=(--generate-notes); fi

if [ "$DRY_RUN" -eq 1 ]; then
    create_cmd="gh release create $TAG --repo $REPO"
    for a in "${CREATE_ARGS[@]}"; do
        create_cmd+=" $(printf '%q' "$a")"
    done
    for a in "${ASSETS[@]}"; do
        create_cmd+=" $(printf '%q' "$a")"
    done
    echo "\$ ${create_cmd%% }"
    if [ "$CLOBBER" -eq 1 ]; then
        upload_cmd="gh release upload $TAG --repo $REPO --clobber"
        for a in "${ASSETS[@]}"; do
            upload_cmd+=" $(printf '%q' "$a")"
        done
        echo "\$ ${upload_cmd}"
    fi
    echo "# tag: $TAG  repo: $REPO  assets: ${#ASSETS[@]}"
    exit 0
fi

command -v gh >/dev/null || die "gh CLI missing: install with 'sudo apt install gh' or 'snap install gh'"
gh auth status >/dev/null 2>&1 || die "gh not authenticated: run 'gh auth login'"

if gh release view "$TAG" --repo "$REPO" >/dev/null 2>&1; then
    if [ "$CLOBBER" -eq 1 ]; then
        gh release upload "$TAG" "${ASSETS[@]}" --repo "$REPO" --clobber
        echo "uploaded ${#ASSETS[@]} assets to existing release $TAG"
    else
        die "release $TAG already exists; use --clobber to overwrite its assets"
    fi
else
    gh release create "$TAG" "${ASSETS[@]}" --repo "$REPO" "${CREATE_ARGS[@]}"
    echo "created release $TAG with ${#ASSETS[@]} assets"
fi
